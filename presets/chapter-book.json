{
  "name": "Chapter Book (5.5×8.5)",
  "description": "For readers of about 7-10. Andika at 14pt with open leading, ragged right and no hyphens, short indented paragraphs, and roomy chapter openings with space for chapter art.",
  "trim": { "w": 5.5, "h": 8.5 },
  "margins": { "top": 0.8, "bottom": 0.85, "inside": 0.85, "outside": 0.65 },
  "font_family": "Andika",
  "font_files": { "regular": "Andika-Regular.ttf", "bold": "Andika-Bold.ttf", "italic": "Andika-Italic.ttf" },
  "body": { "size": 14.0, "leading": 21.0, "indent": 0.25, "justify": false, "hyphenate": false },
  "chapter": {
    "start": "any",
    "sink": 1.6,
    "show_number": true,
    "number_format": "Chapter {n}",
    "number_size": 14.0,
    "title_size": 22.0,
    "after_title": 0.55,
    "open_style": "none",
    "leadin_words": 3,
    "dropcap_lines": 2
  },
  "part_divider": { "show_number": true, "number_format": "Part {n}", "number_size": 15.0, "title_size": 28.0, "sink": 0.35 },
  "document_block": { "frame": "ruled", "indent": 0.25, "font_size": 0, "first_indent": 0.0, "space_around": 12.0, "header_size": 12.0, "dateline_style": "bold" },
  "scene_break": { "type": "glyph", "glyph": "*  *  *", "size": 14.0, "gap": 11.0, "image": "" },
  "running_head": { "show": false, "caps": false, "size": 9.0, "gap": 0.28, "content": "book" },
  "folio": { "show": true, "position": "center", "size": 11.0, "gap": 0.42, "hide_on_opener": true }
}
