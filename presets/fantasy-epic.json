    "leadin_words": 4,
    "dropcap_lines": 3
  },
  "part_divider": { "show_number": true, "number_format": "Part {n}", "number_size": 14.0, "title_size": 30.0, "sink": 0.5 },
  "document_block": { "frame": "ruled", "indent": 0.3, "font_size": 0, "first_indent": 0.0, "space_around": 12.0, "header_size": 9.5, "dateline_style": "italic" },
  "scene_break": { "type": "ornament", "glyph": "•   •   •", "size": 12.0, "gap": 12.0, "image": "", "ornament": "arabesque", "ornament_width": 0.0 },
  "running_head": { "show": true, "caps": true, "size": 8.5, "gap": 0.3 },
  "folio": { "show": true, "position": "outer", "size": 9.5, "gap": 0.42, "hide_on_opener": true }
}
