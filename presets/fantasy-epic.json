{
  "name": "Fantasy (Epic) (6×9)",
  "description": "Ornate and traditional — deep drop-cap chapter openings, airy leading, generous margins, and a decorative scene break. Suits epic and high fantasy. Pairs with the Fantasy Emerald cover.",
  "trim": { "w": 6.0, "h": 9.0 },
  "margins": { "top": 0.85, "bottom": 0.9, "inside": 0.95, "outside": 0.7 },
  "font_family": "Alegreya",
  "font_files": {
    "regular": "Alegreya-Regular.ttf",
    "bold": "Alegreya-Bold.ttf",
    "italic": "Alegreya-Italic.ttf"
  },
  "body": {
    "size": 12.0,
    "leading": 17.0,
    "indent": 0.3,
    "justify": true,
    "hyphenate": false
  },
  "chapter": {
    "start": "recto",
    "sink": 1.4,
    "show_number": true,
    "number_format": "Chapter {n}",
    "number_size": 12.0,
    "title_size": 22.0,
    "after_title": 0.5,
