{
  "name": "Thriller / Crime (5.5×8.5)",
  "description": "Lean and urgent. Large bare chapter numeral, tight leading, no opening flourish — the chapter number does the work. Suits crime fiction, psychological thrillers, and domestic suspense.",
  "trim": { "w": 5.5, "h": 8.5 },
  "margins": { "top": 0.65, "bottom": 0.7, "inside": 0.75, "outside": 0.5 },
  "font_family": "Book",
  "font_files": {
    "regular": "Book-Regular.ttf",
    "bold": "Book-Bold.ttf",
    "italic": "Book-Italic.ttf"
  },
  "body": {
    "size": 10.5,
    "leading": 14.0,
    "indent": 0.25,
    "justify": true,
    "hyphenate": false
  },
  "chapter": {
    "start": "recto",
    "sink": 0.55,
    "show_number": true,
    "number_format": "{n}",
    "number_size": 36.0,
    "title_size": 14.0,
    "after_title": 0.35,
    "open_style": "none",
    "leadin_words": 3,
    "dropcap_lines": 3
  },
  "part_divider": { "show_number": true, "number_format": "Part {n}", "number_size": 11.0, "title_size": 22.0, "sink": 0.4 },
  "document_block": { "frame": "ruled", "indent": 0.25, "font_size": 0, "first_indent": 0.0, "space_around": 11.0, "header_size": 9.0, "dateline_style": "italic" },
  "scene_break": { "type": "glyph", "glyph": "—", "size": 11.0, "gap": 8.0, "image": "" },
  "running_head": { "show": true, "caps": true, "size": 8.0, "gap": 0.25 },
  "folio": { "show": true, "position": "outer", "size": 9.0, "gap": 0.38, "hide_on_opener": true }
}
