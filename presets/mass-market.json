{
  "name": "Mass Market Paperback (4.25×6.87)",
  "description": "The standard retail paperback format. Compact trim, small type, tight margins. The workhorse format for commercial fiction — thrillers, romance, mystery, science fiction.",
  "trim": { "w": 4.25, "h": 6.87 },
  "margins": { "top": 0.5, "bottom": 0.55, "inside": 0.6, "outside": 0.38 },
  "font_family": "Book",
  "font_files": {
    "regular": "Book-Regular.ttf",
    "bold": "Book-Bold.ttf",
    "italic": "Book-Italic.ttf"
  },
  "body": {
    "size": 9.5,
    "leading": 12.5,
    "indent": 0.2,
    "justify": true,
    "hyphenate": true
  },
  "chapter": {
    "start": "recto",
    "sink": 0.45,
    "show_number": true,
    "number_format": "Chapter {n}",
    "number_size": 10.5,
    "title_size": 13.0,
    "after_title": 0.28,
    "open_style": "none",
    "leadin_words": 3,
    "dropcap_lines": 3
  },
  "part_divider": { "show_number": true, "number_format": "Part {n}", "number_size": 10.0, "title_size": 18.0, "sink": 0.35 },
  "document_block": { "frame": "ruled", "indent": 0.2, "font_size": 0, "first_indent": 0.0, "space_around": 10.0, "header_size": 8.5, "dateline_style": "italic" },
  "scene_break": { "type": "glyph", "glyph": "* * *", "size": 10.0, "gap": 7.0, "image": "" },
  "running_head": { "show": true, "caps": true, "size": 7.5, "gap": 0.2 },
  "folio": { "show": true, "position": "outer", "size": 8.5, "gap": 0.34, "hide_on_opener": true }
}
