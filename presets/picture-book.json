{
  "name": "Picture Book (8.5×8.5)",
  "description": "For picture books laid out page by page in the page designer: square, no running heads and no page numbers, Andika for any typed pages. Pair it with full-bleed pages and no generated front matter in the book's settings, and a colour paper under Send to print.",
  "trim": { "w": 8.5, "h": 8.5 },
  "margins": { "top": 0.75, "bottom": 0.75, "inside": 0.75, "outside": 0.75 },
  "font_family": "Andika",
  "font_files": { "regular": "Andika-Regular.ttf", "bold": "Andika-Bold.ttf", "italic": "Andika-Italic.ttf" },
  "body": { "size": 20.0, "leading": 32.0, "indent": 0.0, "justify": false, "hyphenate": false,
            "para_space": 14.0, "keep_whole": true },
  "chapter": {
    "start": "any",
    "sink": 1.0,
    "show_number": false,
    "number_format": "{n}",
    "number_size": 44.0,
    "title_size": 30.0,
    "after_title": 0.5,
    "open_style": "none",
    "leadin_words": 3,
    "dropcap_lines": 2
  },
  "part_divider": { "show_number": false, "number_format": "Part {n}", "number_size": 18.0, "title_size": 32.0, "sink": 0.35 },
  "document_block": { "frame": "ruled", "indent": 0.25, "font_size": 0, "first_indent": 0.0, "space_around": 14.0, "header_size": 14.0, "dateline_style": "bold" },
  "scene_break": { "type": "glyph", "glyph": "*  *  *", "size": 18.0, "gap": 14.0, "image": "" },
  "running_head": { "show": false, "caps": false, "size": 10.0, "gap": 0.28, "content": "book" },
  "folio": { "show": false, "position": "center", "size": 13.0, "gap": 0.45, "hide_on_opener": true }
}
