{
  "name": "Early Reader (6×9)",
  "description": "For children learning to read (about 5-7). Big, clear Andika at 18pt, ragged right, block paragraphs with space between them, and no paragraph broken by a page turn. Big chapter numbers, no running heads.",
  "trim": { "w": 6.0, "h": 9.0 },
  "margins": { "top": 0.9, "bottom": 0.95, "inside": 0.9, "outside": 0.75 },
  "font_family": "Andika",
  "font_files": { "regular": "Andika-Regular.ttf", "bold": "Andika-Bold.ttf", "italic": "Andika-Italic.ttf" },
  "body": { "size": 18.0, "leading": 29.0, "indent": 0.0, "justify": false, "hyphenate": false,
            "para_space": 12.0, "keep_whole": true },
  "chapter": {
    "start": "any",
    "sink": 1.2,
    "show_number": true,
    "number_format": "{n}",
    "number_size": 44.0,
    "title_size": 24.0,
    "after_title": 0.5,
    "open_style": "none",
    "leadin_words": 3,
    "dropcap_lines": 2
  },
  "part_divider": { "show_number": true, "number_format": "Part {n}", "number_size": 18.0, "title_size": 32.0, "sink": 0.35 },
  "document_block": { "frame": "ruled", "indent": 0.25, "font_size": 0, "first_indent": 0.0, "space_around": 14.0, "header_size": 14.0, "dateline_style": "bold" },
  "scene_break": { "type": "glyph", "glyph": "*  *  *", "size": 18.0, "gap": 14.0, "image": "" },
  "running_head": { "show": false, "caps": false, "size": 10.0, "gap": 0.28, "content": "book" },
  "folio": { "show": true, "position": "center", "size": 13.0, "gap": 0.45, "hide_on_opener": false }
}
