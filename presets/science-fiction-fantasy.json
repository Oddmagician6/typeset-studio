{
  "name": "Science Fiction & Fantasy (6×9)",
  "description": "Immersive and world-building-ready. Drop-cap chapter openings, generous page, deep chapter sink. Suits epic fantasy, science fiction, and speculative fiction.",
  "trim": { "w": 6.0, "h": 9.0 },
  "margins": { "top": 0.8, "bottom": 0.85, "inside": 0.9, "outside": 0.65 },
  "font_family": "Alegreya",
  "font_files": {
    "regular": "Alegreya-Regular.ttf",
    "bold": "Alegreya-Bold.ttf",
    "italic": "Alegreya-Italic.ttf"
  },
  "body": {
    "size": 11.5,
    "leading": 16.0,
    "indent": 0.3,
    "justify": true,
    "hyphenate": false
  },
  "chapter": {
    "start": "recto",
    "sink": 1.3,
    "show_number": true,
    "number_format": "Chapter {n}",
    "number_size": 11.0,
    "title_size": 20.0,
    "after_title": 0.45,
    "open_style": "dropcap",
    "leadin_words": 4,
    "dropcap_lines": 3
  },
  "part_divider": { "show_number": true, "number_format": "Part {n}", "number_size": 13.0, "title_size": 28.0, "sink": 0.45 },
  "document_block": { "frame": "ruled", "indent": 0.25, "font_size": 0, "first_indent": 0.0, "space_around": 12.0, "header_size": 9.5, "dateline_style": "italic" },
  "scene_break": { "type": "ornament", "glyph": "* * *", "size": 11.0, "gap": 10.0, "image": "", "ornament": "diamond-trio", "ornament_width": 0.0 },
  "running_head": { "show": true, "caps": true, "size": 8.5, "gap": 0.28 },
  "folio": { "show": true, "position": "outer", "size": 9.5, "gap": 0.42, "hide_on_opener": true }
}
