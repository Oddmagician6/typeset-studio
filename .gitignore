# virtual environment
.venv/

# generated PDFs
out/

# uploaded manuscripts (may contain client content)
uploads/

# saved book projects (manuscripts + settings — user/client content)
projects/

# uploaded cover-art assets (background images, emblems/logos)
covers/assets/

# uploaded interior illustrations (~~~ figure src="…")
figures/

# Python bytecode
__pycache__/
*.pyc
*.pyo

# OS noise
.DS_Store
Thumbs.db

# PyInstaller build output (the .spec is tracked; build artifacts are not)
build/
dist/

# Inno Setup output (the .iss is tracked; the built Setup.exe is not)
dist_installer/

# per-user preferences (update-check toggle and its cache) - not project content
settings.json

# rendered reels (the HTML reels and their sources are tracked; the encoded
# video is a build output - promo/README.md regenerates it in about 3 minutes)
promo/*.mp4
promo/frames/

# raw promo screenshots (large, disposable; TYPESET_PROMO_SHOTS overrides the path)
promo/shots/

# local agent/editor settings - not project content
.claude/settings.local.json

# internal working notes that point at paths outside this repo
SCREENSHOTS-FOR-WEBSITE.md
